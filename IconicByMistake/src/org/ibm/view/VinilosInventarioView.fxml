<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #F4F6F4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.VinilosInventarioController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <left>
        <VBox alignment="TOP_CENTER" maxWidth="310.0" minWidth="310.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" BorderPane.alignment="TOP_CENTER">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleVolverMenu" prefHeight="35.0" prefWidth="110.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="← Menú" BorderPane.alignment="TOP_LEFT" />
                
                <Label style="-fx-font-size: 16px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Inventario de Vinilos" />
                
                <Label style="-fx-font-family: 'Century Gothic'; -fx-text-fill: #555555; -fx-font-size: 12px;" text="Seleccione un vinilo de la lista para ver su detalle e imagen de carátula." wrapText="true" />
                
                <!-- Contenedor Visual con fx:id="imgVinilo" enlazado al controlador -->
                <VBox alignment="CENTER" prefHeight="220.0" prefWidth="220.0" style="-fx-border-color: #EEEEEE; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #FAFAFA;">
                    <children>
                        <ImageView fx:id="imgVinilo" fitHeight="200.0" fitWidth="200.0" preserveRatio="true" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Catálogo y Stock de Discos" />
                
                <TextField fx:id="txtBuscar" prefHeight="35.0" promptText="Buscar por SKU, título, precio o stock…" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;" />
                
                <TableView fx:id="tablaVinilos" style="-fx-font-family: 'Century Gothic';" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSku" prefWidth="130.0" style="-fx-font-family: 'Century Gothic';" text="SKU" />
                        <TableColumn fx:id="colTitulo" prefWidth="260.0" style="-fx-font-family: 'Century Gothic';" text="Título" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" style="-fx-font-family: 'Century Gothic';" text="Precio" />
                        <TableColumn fx:id="colStock" prefWidth="90.0" style="-fx-font-family: 'Century Gothic';" text="Stock" />
                    </columns>
                </TableView>
            </children>
            <BorderPane.margin>
                <Insets left="15.0" />
            </BorderPane.margin>
        </VBox>
    </center>
</BorderPane>