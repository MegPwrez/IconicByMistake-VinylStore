<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1100.0" style="-fx-background-color: #F4F6F4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.ProductoresController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <left>
        <VBox BorderPane.alignment="TOP_CENTER" maxWidth="310.0" minWidth="310.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleVolverMenu" prefHeight="35.0" prefWidth="110.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="← Menú" />
                
                <Label style="-fx-font-size: 16px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Registrar Productor" />
                
                <TextField fx:id="txtIdProductor" disable="true" prefHeight="32.0" promptText="ID Productor" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;" />
                <TextField fx:id="txtNombreProductor" disable="true" prefHeight="32.0" promptText="Nombre del Productor" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;" />
                <TextField fx:id="txtSelloDiscografico" disable="true" prefHeight="32.0" promptText="Sello Discográfico" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;" />
                
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnNuevo" onAction="#handleNuevo" prefHeight="35.0" prefWidth="135.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="Nuevo +" />
                        <Button fx:id="btnEditar" onAction="#handleEditar" prefHeight="35.0" prefWidth="135.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #40916C; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Editar" />
                    </children>
                </HBox>
                
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" disable="true" onAction="#handleGuardar" prefHeight="36.0" prefWidth="135.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="Guardar" />
                        <Button fx:id="btnCancelar" disable="true" onAction="#handleCancelar" prefHeight="36.0" prefWidth="135.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #FFFFFF; -fx-text-fill: #2D6A4F; -fx-border-color: #2D6A4F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar" />
                    </children>
                </HBox>
                
                <Label fx:id="lblMensaje" style="-fx-font-family: 'Century Gothic'; -fx-font-size: 11px;" wrapText="true" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox BorderPane.alignment="TOP_CENTER" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Lista de Productores" />
                
                <TextField fx:id="txtBuscar" prefHeight="35.0" promptText="Buscar por ID, nombre o sello discográfico…" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;" />
                
                <TableView fx:id="tablaProductores" style="-fx-font-family: 'Century Gothic';" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdProductor" prefWidth="100.0" style="-fx-font-family: 'Century Gothic';" text="ID Productor" />
                        <TableColumn fx:id="colNombreProductor" prefWidth="200.0" style="-fx-font-family: 'Century Gothic';" text="Nombre" />
                        <TableColumn fx:id="colSelloDiscografico" prefWidth="195.0" style="-fx-font-family: 'Century Gothic';" text="Sello Discográfico" />
                    </columns>
                </TableView>
                
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <children>
                        <Button fx:id="btnPrimero" onAction="#handlePrimero" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Primero" />
                        <Button fx:id="btnAnterior" onAction="#handleAnterior" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Anterior" />
                        <Button fx:id="btnSiguiente" onAction="#handleSiguiente" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Siguiente" />
                        <Button fx:id="btnUltimo" onAction="#handleUltimo" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Último" />
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets left="15.0" />
            </BorderPane.margin>
        </VBox>
    </center>
</BorderPane>