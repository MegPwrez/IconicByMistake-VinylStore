<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.FacturaController">
   <children>
      
      <Label layoutX="140.0" layoutY="20.0" text="Vista Previa de Factura">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>

      <TextArea fx:id="txtAreaFactura" editable="false" layoutX="40.0" layoutY="65.0" prefHeight="440.0" prefWidth="420.0" style="-fx-font-family: 'Courier New'; -fx-font-size: 13px;" />

      <Button layoutX="40.0" layoutY="525.0" mnemonicParsing="false" onAction="#handleVolver" prefHeight="35.0" prefWidth="115.0" text="Regresar" />
      <Button fx:id="btnfacturapdf" layoutX="179.0" layoutY="525.0" mnemonicParsing="false" onAction="#handleExportarpdf" prefHeight="35.0" prefWidth="163.0" text="Exportar como PDF" />
      
   </children>
</AnchorPane>