<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="org.ibm.controller.ViniloController" prefHeight="650.0" prefWidth="1100.0" style="-fx-background-color: #F4F6F4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <left>
        <VBox BorderPane.alignment="TOP_CENTER" maxWidth="310.0" minWidth="310.0" spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleVolver" prefHeight="35.0" prefWidth="110.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="← Menú"/>
                
                <Label style="-fx-font-size: 16px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Registrar Vinilo"/>
                
                <TextField disable="true" fx:id="txtCodigoVinilo" prefHeight="32.0" promptText="Código / ISBN" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;"/>
                <TextField disable="true" fx:id="txtTitulo" prefHeight="32.0" promptText="Título" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;"/>
                <TextField disable="true" fx:id="txtFechaLanzamiento" prefHeight="32.0" promptText="Fecha de Lanzamiento (ej: 2024)" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;"/>
                <TextField disable="true" fx:id="txtPrecio" prefHeight="32.0" promptText="Precio" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;"/>
                <TextField disable="true" fx:id="txtStock" prefHeight="32.0" promptText="Stock" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;"/>
                
                <ComboBox disable="true" fx:id="cmbArtista" prefHeight="32.0" prefWidth="280.0" promptText="Seleccionar Artista" style="-fx-font-family: 'Century Gothic';"/>
                <ComboBox disable="true" fx:id="cmbGenero" prefHeight="32.0" prefWidth="280.0" promptText="Seleccionar Género" style="-fx-font-family: 'Century Gothic';"/>
                <ComboBox disable="true" fx:id="cmbProductor" prefHeight="32.0" prefWidth="280.0" promptText="Seleccionar Productor" style="-fx-font-family: 'Century Gothic';"/>
                
                <VBox alignment="CENTER" style="-fx-background-color: #FAFAFA; -fx-background-radius: 6; -fx-border-color: #EEEEEE; -fx-border-radius: 6;">
                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                    </padding>
                    <children>
                        <ImageView fitHeight="130.0" fitWidth="100.0" fx:id="imgPortada" pickOnBounds="true" preserveRatio="true"/>
                    </children>
                </VBox>
                
                <Button disable="true" fx:id="btnCambiarFoto" onAction="#handleCambiarFoto" prefHeight="35.0" prefWidth="280.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #12261E; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Cambiar foto"/>
                
                <HBox spacing="10.0">
                    <children>
                        <Button onAction="#handleGuardar" prefHeight="36.0" prefWidth="135.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="Guardar"/>
                        <Button onAction="#handleCancelar" prefHeight="36.0" prefWidth="135.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #FFFFFF; -fx-text-fill: #2D6A4F; -fx-border-color: #2D6A4F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancelar"/>
                    </children>
                </HBox>
                
                <Label fx:id="lblMensaje" style="-fx-font-family: 'Century Gothic'; -fx-font-size: 11px;" wrapText="true"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox BorderPane.alignment="TOP_CENTER" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Lista de Vinilos"/>
                
                <TextField fx:id="txtBuscar" prefHeight="35.0" promptText="Buscar por código, título, fecha, precio o stock…" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;"/>
                
                <TableView VBox.vgrow="ALWAYS" fx:id="tablaVinilos" style="-fx-font-family: 'Century Gothic';">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" style="-fx-font-family: 'Century Gothic';" text="Código"/>
                        <TableColumn fx:id="colTitulo" prefWidth="150.0" style="-fx-font-family: 'Century Gothic';" text="Título"/>
                        <TableColumn fx:id="colFecha" prefWidth="115.0" style="-fx-font-family: 'Century Gothic';" text="Fecha Lanzamiento"/>
                        <TableColumn fx:id="colPrecio" prefWidth="80.0" style="-fx-font-family: 'Century Gothic';" text="Precio"/>
                        <TableColumn fx:id="colStock" prefWidth="75.0" style="-fx-font-family: 'Century Gothic';" text="Stock"/>
                        <TableColumn fx:id="colArtista" prefWidth="95.0" style="-fx-font-family: 'Century Gothic';" text="Artista"/>
                        <TableColumn fx:id="colGenero" prefWidth="95.0" style="-fx-font-family: 'Century Gothic';" text="Género"/>
                        <TableColumn fx:id="colProductor" prefWidth="105.0" style="-fx-font-family: 'Century Gothic';" text="Productor"/>
                    </columns>
                </TableView>
                
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <HBox HBox.hgrow="ALWAYS" spacing="10.0">
                            <children>
                                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefHeight="35.0" prefWidth="110.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="Nuevo +"/>
                                <Button fx:id="btnEditar" onAction="#handleEditar" prefHeight="35.0" prefWidth="110.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #40916C; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Editar"/>
                            </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                            <children>
                                <Button fx:id="btnPrimero" onAction="#handlePrimero" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Primero"/>
                                <Button fx:id="btnAnterior" onAction="#handleAnterior" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Anterior"/>
                                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Siguiente"/>
                                <Button fx:id="btnUltimo" onAction="#handleUltimo" prefHeight="32.0" prefWidth="75.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #E9ECEF; -fx-text-fill: #12261E; -fx-background-radius: 6; -fx-cursor: hand;" text="Último"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
            <BorderPane.margin>
                <Insets left="15.0"/>
            </BorderPane.margin>
        </VBox>
    </center>
</BorderPane>