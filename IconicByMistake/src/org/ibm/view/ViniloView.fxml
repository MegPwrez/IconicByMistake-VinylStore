<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.ViniloController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolver" text="Volver al Menú" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Vinilo" />
            <TextField fx:id="txtCodigoVinilo" disable="true" prefHeight="30.0" promptText="Código / ISBN" />
            <TextField fx:id="txtTitulo" disable="true" prefHeight="30.0" promptText="Título" />
            <!-- Modificado: Cambiado DatePicker por TextField de texto plano -->
            <TextField fx:id="txtFechaLanzamiento" disable="true" prefHeight="30.0" promptText="Fecha de Lanzamiento (ej: 2024)" />
            <TextField fx:id="txtPrecio" disable="true" prefHeight="30.0" promptText="Precio" />
            <TextField fx:id="txtStock" disable="true" prefHeight="30.0" promptText="Stock" />
            <ComboBox fx:id="cmbArtista" disable="true" prefHeight="29.0" prefWidth="280.0" promptText="Seleccionar Artista" />
            <ComboBox fx:id="cmbGenero" disable="true" prefHeight="30.0" prefWidth="277.0" promptText="Seleccionar Género" />
            <ComboBox fx:id="cmbProductor" disable="true" prefHeight="30.0" prefWidth="277.0" promptText="Seleccionar Productor" />
            <ImageView fx:id="imgPortada" fitHeight="170.0" fitWidth="127.0" pickOnBounds="true" preserveRatio="true" />
            <Button fx:id="btnCambiarFoto" disable="true" onAction="#handleCambiarFoto" prefHeight="30.0" prefWidth="120" text="Cambiar foto" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleCancelar" prefWidth="120" text="Cancelar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Vinilos" />
            <TextField fx:id="txtBuscar" promptText="Buscar por código, título, fecha, precio o stock…" />
            <TableView fx:id="tablaVinilos">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="110" text="Código" />
                    <TableColumn fx:id="colTitulo" prefWidth="180" text="Título" />
                    <TableColumn fx:id="colFecha" prefWidth="120" text="Fecha Lanzamiento" />
                    <TableColumn fx:id="colPrecio" prefWidth="90" text="Precio" />
                    <TableColumn fx:id="colStock" prefWidth="90" text="Stock" />
                    <TableColumn fx:id="colArtista" prefWidth="100" text="Artista" />
                    <TableColumn fx:id="colGenero" prefWidth="100" text="Género" />
                    <TableColumn fx:id="colProductor" prefWidth="110" text="Productor" />
                </columns>
            </TableView>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                     <HBox spacing="10">
                         <Button fx:id="btnNuevo" onAction="#handleNuevo" prefWidth="120" text="Nuevo +" />
                         <Button fx:id="btnEditar" onAction="#handleEditar" prefWidth="120" text="Editar" />
                     </HBox>
                     <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="538.0" spacing="10">
                         <Button fx:id="btnPrimero" onAction="#handlePrimero" text="Primero" />
                         <Button fx:id="btnAnterior" onAction="#handleAnterior" text="Anterior" />
                         <Button fx:id="btnSiguiente" onAction="#handleSiguiente" text="Siguiente" />
                         <Button fx:id="btnUltimo" onAction="#handleUltimo" text="Último" />
                     </HBox>
               </children>
            </HBox>
        </VBox>
    </center>
</BorderPane>