<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F0F5F3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.ArtistasController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolverMenu" prefHeight="31.0" prefWidth="117.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #8FB5A1;" text="Volver al Menú" textFill="#f8f5f5" />
            <Label style="-fx-font-size: 18; -fx-font-family: &quot;Century Gothic&quot;; -fx-font-weight: bold;" text="Registrar Artista" textFill="#395c4a" />
            <TextField fx:id="txtNombreArtistico" disable="true" prefHeight="30.0" promptText="Nombre Artístico" style="-fx-font-family: &quot;Century Gothic&quot;;" />
            <TextField fx:id="txtNacionalidad" disable="true" prefHeight="30.0" promptText="Nacionalidad" style="-fx-font-family: &quot;Century Gothic&quot;;" />
            <TextArea fx:id="txtBiografia" disable="true" prefHeight="80.0" promptText="Biografía" style="-fx-font-family: &quot;Century Gothic&quot;;" />
            <HBox spacing="10">
                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefHeight="30.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #658273;" text="Nuevo" textFill="WHITE" />
                <Button fx:id="btnEditar" onAction="#handleEditar" prefHeight="30.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #386646;" text="Editar" textFill="WHITE" />
            </HBox>
            <HBox spacing="10">
                <Button fx:id="btnGuardar" disable="true" onAction="#handleGuardar" prefHeight="30.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #1E8A35;" text="Guardar" textFill="WHITE" />
                <Button fx:id="btnCancelar" disable="true" onAction="#handleCancelar" prefHeight="30.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #55AB66;" text="Cancelar" textFill="WHITE" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-family: &quot;Century Gothic&quot;; -fx-font-weight: bold;" text="Lista de Artistas" textFill="#395c4a" />
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre, nacionalidad o biografía…" style="-fx-font-family: &quot;Century Gothic&quot;;" />
            <TableView fx:id="tablaArtistas" style="-fx-font-family: &quot;Century Gothic&quot;;">
                <columns>
                    <TableColumn fx:id="colIdArtista" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colNombreArtistico" prefWidth="180" text="Nombre Artístico" />
                    <TableColumn fx:id="colNacionalidad" prefWidth="150" text="Nacionalidad" />
                    <TableColumn fx:id="colBiografia" prefWidth="220" text="Biografía" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnPrimero" onAction="#handlePrimero" prefHeight="31.0" prefWidth="60.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Primero" />
                <Button fx:id="btnAnterior" onAction="#handleAnterior" prefHeight="31.0" prefWidth="62.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" prefHeight="30.0" prefWidth="70.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Siguiente" />
                <Button fx:id="btnUltimo" onAction="#handleUltimo" prefHeight="32.0" prefWidth="52.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Último" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
