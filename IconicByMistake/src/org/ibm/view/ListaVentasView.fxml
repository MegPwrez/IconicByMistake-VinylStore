<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.ListaVentasController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolver" text="Volver al Menú" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Venta" />
            
            <TextField fx:id="txtTotal" disable="true" prefHeight="30.0" promptText="Total de la venta" />
            <ComboBox fx:id="cmbCliente" disable="true" prefHeight="30.0" promptText="Cliente" />
            <DatePicker fx:id="dpFecha" disable="true" prefHeight="30.0" promptText="Fecha de la venta" />
            <ComboBox fx:id="cmbUsuario" disable="true" prefHeight="30.0" promptText="Usuario que atendió" />
            
            <HBox spacing="10">
                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefWidth="120" text="Nuevo" />
                <Button fx:id="btnEditar" onAction="#handleEditar" prefWidth="120" text="Editar" />
            </HBox>
            
            <HBox spacing="10">
                <Button fx:id="btnGuardar" onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button fx:id="btnCancelar" onAction="#handleCancelar" prefWidth="120" text="Cancelar" />
            </HBox>
            
            <HBox spacing="10">
                <Button fx:id="btnFactura" onAction="#handleFactura" prefWidth="120" text="Ver Factura" />
            </HBox>
            
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Ventas" />
            <TextField fx:id="txtBuscar" promptText="Buscar por no. venta, fecha, total o CUI…" />
            
            <TableView fx:id="tablaVentas">
                <columns>
                    <TableColumn fx:id="colNoVenta" prefWidth="110" text="No. Venta" />
                    <TableColumn fx:id="colFechaVenta" prefWidth="160" text="Fecha" />
                    <TableColumn fx:id="colTotalVenta" prefWidth="110" text="Total" />
                    <TableColumn fx:id="colCuiCliente" prefWidth="150" text="CUI Cliente" />
                    <TableColumn fx:id="colUsuario" prefWidth="90" text="Usuario" />
                </columns>
            </TableView>
            
            <HBox spacing="10">
                <Button fx:id="btnPrimero" onAction="#handlePrimero" text="Primero" />
                <Button fx:id="btnAnterior" onAction="#handleAnterior" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" text="Siguiente" />
                <Button fx:id="btnUltimo" onAction="#handleUltimo" text="Último" />
                <Button fx:id="btnObtenerReporte" onAction="#handleObtenerReporte" text="Obtener Reporte" />
            </HBox>
        </VBox>
    </center>
</BorderPane>