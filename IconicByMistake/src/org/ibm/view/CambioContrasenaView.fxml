<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0"
            prefWidth="1100.0"
            style="-fx-background-color: #F0F5F3;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ibm.controller.CambioContrasenaController">

    <children>

        <!-- BARRA LATERAL -->
        <VBox prefWidth="220.0"
              spacing="15.0"
              style="-fx-background-color: #071A09;"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <padding>
                <Insets top="30.0"
                        right="20.0"
                        bottom="25.0"
                        left="20.0"/>
            </padding>

            <children>

                <Label text="ICONIC BY&#10;MISTAKE"
                       textFill="WHITE">
                    <font>
                        <Font name="Century Gothic Bold"
                              size="22.0"/>
                    </font>
                </Label>

                <Label text="Administración"
                       textFill="#9BBABA">
                    <font>
                        <Font name="Century Gothic"
                              size="13.0"/>
                    </font>
                </Label>

                <Label text="Seguridad"
                       style="-fx-background-color: #386646;
                              -fx-text-fill: white;
                              -fx-font-weight: bold;
                              -fx-background-radius: 8px;
                              -fx-padding: 11px 14px;"
                       maxWidth="1.7976931348623157E308"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnVolver"
                        text="←  Volver al panel"
                        onAction="#volverAlDashboard"
                        maxWidth="1.7976931348623157E308"
                        style="-fx-background-color: #386646;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8px;
                               -fx-padding: 11px 15px;
                               -fx-cursor: hand;"/>

            </children>
        </VBox>

        <!-- CONTENIDO -->
        <VBox spacing="18.0"
              AnchorPane.leftAnchor="270.0"
              AnchorPane.rightAnchor="70.0"
              AnchorPane.topAnchor="80.0">

            <children>

                <Label text="Cambiar contraseña"
                       textFill="#071A09">
                    <font>
                        <Font name="Century Gothic Bold"
                              size="30.0"/>
                    </font>
                </Label>

                <Label text="Actualiza la contraseña de tu cuenta de forma segura."
                       textFill="#658273">
                    <font>
                        <Font name="Century Gothic"
                              size="14.0"/>
                    </font>
                </Label>

                <!-- TARJETA -->
                <VBox maxWidth="600.0"
                      spacing="18.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12px;
                             -fx-border-color: #9BBABA;
                             -fx-border-radius: 12px;
                             -fx-border-width: 1px;">

                    <padding>
                        <Insets top="30.0"
                                right="30.0"
                                bottom="30.0"
                                left="30.0"/>
                    </padding>

                    <children>

                        <Label text="Seguridad de la cuenta"
                               textFill="#071A09">
                            <font>
                                <Font name="Century Gothic Bold"
                                      size="18.0"/>
                            </font>
                        </Label>

                        <Label text="Contraseña actual"
                               textFill="#386646"/>

                        <PasswordField fx:id="txtContrasenaActual"
                                       promptText="Ingrese su contraseña actual"
                                       prefHeight="40.0"
                                       style="-fx-background-color: #F0F5F3;
                                              -fx-border-color: #9BBABA;
                                              -fx-border-radius: 7px;
                                              -fx-background-radius: 7px;"/>

                        <Label text="Nueva contraseña"
                               textFill="#386646"/>

                        <PasswordField fx:id="txtNuevaContrasena"
                                       promptText="Ingrese la nueva contraseña"
                                       prefHeight="40.0"
                                       style="-fx-background-color: #F0F5F3;
                                              -fx-border-color: #9BBABA;
                                              -fx-border-radius: 7px;
                                              -fx-background-radius: 7px;"/>

                        <Label text="Confirmar nueva contraseña"
                               textFill="#386646"/>

                        <PasswordField fx:id="txtConfirmarContrasena"
                                       promptText="Repita la nueva contraseña"
                                       prefHeight="40.0"
                                       style="-fx-background-color: #F0F5F3;
                                              -fx-border-color: #9BBABA;
                                              -fx-border-radius: 7px;
                                              -fx-background-radius: 7px;"/>

                        <Label text="La nueva contraseña debe contener al menos 6 caracteres."
                               textFill="#658273">
                            <font>
                                <Font name="Century Gothic"
                                      size="11.0"/>
                            </font>
                        </Label>

                        <Button fx:id="btnCambiar"
                                text="Actualizar contraseña"
                                onAction="#cambiarContrasena"
                                prefHeight="42.0"
                                maxWidth="1.7976931348623157E308"
                                style="-fx-background-color: #1E8A35;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8px;
                                       -fx-cursor: hand;"/>

                    </children>
                </VBox>

            </children>
        </VBox>

    </children>
</AnchorPane>