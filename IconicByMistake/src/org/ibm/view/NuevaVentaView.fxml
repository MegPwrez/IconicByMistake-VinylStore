<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F0F5F3; -fx-font-family: 'Century Gothic';" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.NuevaVentaController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <left>
      <VBox maxWidth="320.0" minWidth="320.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(7, 26, 9, 0.08), 10, 0, 0, 3); -fx-border-color: #9BBABA; -fx-border-radius: 12; -fx-border-width: 0.5;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Button onAction="#handleVolver" style="-fx-background-color: transparent; -fx-border-color: #658273; -fx-border-radius: 6; -fx-text-fill: #386646; -fx-font-size: 12px; -fx-cursor: hand;" text="← Volver al Menú" />
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #071A09;" text="Registrar Venta" />
            <Separator style="-fx-opacity: 0.5;" />
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-text-fill: #386646; -fx-font-size: 12px; -fx-font-weight: bold;" text="Cliente" />
                  <ComboBox fx:id="cmbCliente" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Seleccione el cliente" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6;" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-text-fill: #386646; -fx-font-size: 12px; -fx-font-weight: bold;" text="Vinilo" />
                  <ComboBox fx:id="cmbVinilo" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Seleccione un vinilo" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6;" />
               </children>
            </VBox>
            <HBox alignment="BOTTOM_LEFT" spacing="10.0">
               <children>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #386646; -fx-font-size: 12px; -fx-font-weight: bold;" text="Cantidad" />
                        <Spinner fx:id="spCantidad" maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6;" />
                     </children>
                  </VBox>
                  <Button fx:id="btnAgregar" onAction="#handleAgregarLinea" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #55AB66; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Agregar" />
               </children>
            </HBox>
            <Separator style="-fx-opacity: 0.5;" />
            <VBox spacing="10.0" style="-fx-background-color: #F0F5F3; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #8FB5A1; -fx-border-radius: 8;">
               <children>
                  <Label fx:id="lblTotal" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #071A09;" text="Total: Q0.00" />
               </children>
            </VBox>
            <Button fx:id="btnRegistrar" maxWidth="1.7976931348623157E308" onAction="#handleRegistrarVenta" prefHeight="42.0" style="-fx-background-color: #1E8A35; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(30, 138, 53, 0.25), 6, 0, 0, 2);" text="✔ Registrar Venta" />
            <Label fx:id="lblMensaje" style="-fx-text-fill: #386646; -fx-font-size: 12px;" wrapText="true" />
         </children>
         <BorderPane.margin>
            <Insets right="20.0" />
         </BorderPane.margin>
      </VBox>
   </left>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #071A09;" text="Líneas de Venta" />
                  <Label style="-fx-font-size: 12px; -fx-text-fill: #658273;" text="Artículos añadidos al carrito actual" />
               </children>
            </VBox>
            <TableView fx:id="tablaLineas" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #9BBABA; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(7, 26, 9, 0.04), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodigoBarras" prefWidth="120.0" text="Código de Barras" />
                  <TableColumn fx:id="colTitulo" prefWidth="220.0" text="Título" />
                  <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                  <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad" />
                  <TableColumn fx:id="colsubtotal" prefWidth="110.0" text="Subtotal" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btnQuitar" onAction="#handleQuitarLinea" style="-fx-background-color: #FFFFFF; -fx-border-color: #658273; -fx-border-radius: 6; -fx-text-fill: #386646; -fx-cursor: hand;" text="🗑 Quitar Seleccionado" />
                  <Button fx:id="btnVaciar" onAction="#handleVaciar" style="-fx-background-color: #FFFFFF; -fx-border-color: #658273; -fx-border-radius: 6; -fx-text-fill: #386646; -fx-cursor: hand;" text="❌ Vaciar Carrito" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>