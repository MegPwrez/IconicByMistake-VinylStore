<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F0F5F3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.GenerosController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolverMenu" prefHeight="32.0" prefWidth="104.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #8FB5A1;" text="Volver al Menú" textFill="WHITE" />
            <Label style="-fx-font-size: 18; -fx-font-family: &quot;Century Gothic&quot;; -fx-font-weight: bold;" text="Registrar Género" />
            
            <!-- Campo oculto o de solo lectura para el ID si lo requieres visualmente -->
            <TextField fx:id="txtIdGenero" managed="false" visible="false" />
            
            <TextField fx:id="txtNombre" disable="true" prefHeight="30.0" promptText="Nombre del género" />
            <HBox spacing="10">
                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefHeight="33.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #658273;" text="Nuevo" textFill="#fffefe" />
                <Button fx:id="btnEditar" onAction="#handleEditar" prefHeight="33.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #386646;" text="Editar" textFill="WHITE" />
            </HBox>
            <HBox spacing="10">
                <Button fx:id="btnGuardar" disable="true" onAction="#handleGuardar" prefHeight="33.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #1E8A35;" text="Guardar" textFill="WHITE" />
                <Button fx:id="btnCancelar" disable="true" onAction="#handleCancelar" prefHeight="33.0" prefWidth="120" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #386646;" text="Cancelar" textFill="WHITE" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-family: &quot;Century Gothic&quot;; -fx-font-weight: bold;" text="Lista de Géneros" />
            <TextField fx:id="txtBuscar" promptText="Buscar por ID o nombre…" style="-fx-font-family: &quot;Century Gothic&quot;;" />
            <TableView fx:id="tablaGeneros" style="-fx-font-family: &quot;Century Gothic&quot;;">
                <columns>
                    <TableColumn fx:id="colIdGenero" prefWidth="100" text="ID" />
                    <TableColumn fx:id="colNombreGenero" prefWidth="300" text="Nombre Género" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnPrimero" onAction="#handlePrimero" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Primero" />
                <Button fx:id="btnAnterior" onAction="#handleAnterior" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Siguiente" />
                <Button fx:id="btnUltimo" onAction="#handleUltimo" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #9BBABA;" text="Último" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
