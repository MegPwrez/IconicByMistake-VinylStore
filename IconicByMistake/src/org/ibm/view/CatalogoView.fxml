<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="950.0" style="-fx-background-color: #F4F6F4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.CatalogoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#handleVolver" prefHeight="35.0" prefWidth="120.0" style="-fx-font-family: 'Century Gothic'; -fx-background-color: #2D6A4F; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;" text="← Menú" />
                <Label prefHeight="50.0" style="-fx-font-size: 20px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Catálogo de Vinilos">
               <font>
                  <Font name="Century Gothic Bold" size="18.0" />
               </font></Label>
                <TextField fx:id="txtBuscar" promptText="Buscar por título o código..." prefHeight="35.0" prefWidth="300.0" style="-fx-font-family: 'Century Gothic'; -fx-background-radius: 6; -fx-border-color: #D0D0D0; -fx-border-radius: 6;" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Century Gothic" size="13.0" />
               </font></TextField>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F4F6F4;">
            <content>
                <VBox style="-fx-background-color: #F4F6F4;">
                    <children>
                        <TilePane fx:id="tileCatalogo" hgap="16.0" prefColumns="4" tileAlignment="TOP_LEFT" vgap="16.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding></TilePane>
                    </children>
                </VBox>
            </content>
            <BorderPane.margin>
                <Insets />
            </BorderPane.margin>
            <padding>
                <Insets bottom="15.0" left="15.0" right="10.0" top="15.0" />
            </padding>
        </ScrollPane>
    </center>
    <right>
        <VBox prefWidth="320.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" BorderPane.alignment="TOP_CENTER">
            <children>
                <Label style="-fx-font-size: 15px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #12261E;" text="Detalle del Vinilo" />
                
                <VBox alignment="CENTER" style="-fx-background-color: #FAFAFA; -fx-background-radius: 8; -fx-border-color: #EEEEEE; -fx-border-radius: 8;">
                    <children>
                        <ImageView fx:id="imgDetalle" fitHeight="220.0" fitWidth="200.0" preserveRatio="true" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>

                <Label fx:id="lblDetalleTitulo" style="-fx-font-size: 15px; -fx-font-family: 'Century Gothic'; -fx-font-weight: bold; -fx-text-fill: #2D6A4F;" wrapText="true" />
                <Label fx:id="lblDetalleCodigo" style="-fx-font-family: 'Century Gothic'; -fx-text-fill: #555555; -fx-font-size: 12px;" wrapText="true" />
                <Label fx:id="lblDetallePrecio" style="-fx-font-family: 'Century Gothic'; -fx-text-fill: #12261E; -fx-font-weight: bold; -fx-font-size: 13px;" wrapText="true" />
                <Label fx:id="lblDetalleStock" style="-fx-font-family: 'Century Gothic'; -fx-text-fill: #555555; -fx-font-size: 12px;" wrapText="true" />
                <Label fx:id="lblDetalleArtista" style="-fx-font-family: 'Century Gothic'; -fx-text-fill: #555555; -fx-font-size: 12px;" wrapText="true" />
                
                <Label fx:id="lblDetalleMensaje" style="-fx-font-style: italic; -fx-font-family: 'Century Gothic'; -fx-text-fill: #888888; -fx-font-size: 11px;" text="Seleccione un vinilo de la cuadrícula para ver su detalle." wrapText="true" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <BorderPane.margin>
                <Insets bottom="15.0" left="10.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </VBox>
    </right>
</BorderPane>