<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F0F5F3;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.CatalogoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#handleVolver" prefHeight="34.0" prefWidth="104.0" style="-fx-font-family: &quot;Century Gothic&quot;; -fx-background-color: #8FB5A1;" text="Volver al Menú" textFill="WHITE" />
                <Label prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-family: &quot;Century Gothic&quot;; -fx-font-weight: bold;" text="Catálogo de Vinilos" textFill="#395c4a">
               <font>
                  <Font name="Century Gothic" size="13.0" />
               </font></Label>
                <TextField fx:id="txtBuscar" promptText="Buscar por título o código..." HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Century Gothic" size="13.0" />
               </font></TextField>
            </children>
            <padding>
                <Insets left="10.0" right="10.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" prefHeight="476.0" prefWidth="600.0" style="-fx-background-color: #EDF7F1;">
            <content>
                <VBox>
                    <children>
                        <TilePane fx:id="tileCatalogo" hgap="16.0" prefColumns="5" tileAlignment="TOP_LEFT" vgap="16.0" />
                    </children>
                </VBox>
            </content>
            <BorderPane.margin>
                <Insets bottom="25.0" left="25.0" top="10.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="25.0" left="25.0" top="10.0" />
            </padding>
        </ScrollPane>
    </center>
    <right>
        <VBox prefWidth="300.0" spacing="10.0" BorderPane.alignment="TOP_LEFT">
            <children>
                <Label fx:id="lblDetalleTitulo" style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true" />
                <ImageView fx:id="imgDetalle" fitHeight="279.0" fitWidth="233.0" preserveRatio="true">
                    <VBox.margin>
                        <Insets left="25.0" />
                    </VBox.margin>
                </ImageView>
                <Label fx:id="lblDetalleCodigo" wrapText="true" />
                <Label fx:id="lblDetallePrecio" wrapText="true" />
                <Label fx:id="lblDetalleStock" wrapText="true" />
                <Label fx:id="lblDetalleArtista" wrapText="true" />
                <Label fx:id="lblDetalleMensaje" style="-fx-font-style: italic; -fx-font-family: &quot;Century Gothic&quot;; -fx-text-fill: #888888;" text="Seleccione un vinilo de la cuadrícula para ver su detalle." wrapText="true" />
            </children>
            <padding>
                <Insets left="10.0" />
            </padding>
            <BorderPane.margin>
                <Insets left="10.0" />
            </BorderPane.margin>
        </VBox>
    </right>
</BorderPane>
