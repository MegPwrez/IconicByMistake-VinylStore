<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F0F5F3; -fx-font-family: 'Century Gothic';" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ibm.controller.DetalleVentaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <left>
        <VBox maxWidth="320.0" minWidth="320.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(7, 26, 9, 0.08), 10, 0, 0, 3); -fx-border-color: #9BBABA; -fx-border-radius: 12; -fx-border-width: 0.5;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Button onAction="#handleVolver" style="-fx-background-color: transparent; -fx-border-color: #658273; -fx-border-radius: 6; -fx-text-fill: #386646; -fx-font-size: 12px; -fx-cursor: hand;" text="← Volver al Menú" />
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #071A09;" text="Registrar Detalle" />
                <Separator style="-fx-opacity: 0.5;" />
                <ComboBox fx:id="cmbVenta" disable="true" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Venta" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6;" />
                <ComboBox fx:id="cmbLibro" disable="true" maxWidth="1.7976931348623157E308" prefHeight="38.0" promptText="Libro" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6;" />
                <TextField fx:id="txtCantidad" disable="true" prefHeight="38.0" promptText="Cantidad" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6; -fx-prompt-text-fill: #658273;" />
                <TextField fx:id="txtPrecio" disable="true" prefHeight="38.0" promptText="Precio" style="-fx-background-color: #F0F5F3; -fx-background-radius: 6; -fx-border-color: #9BBABA; -fx-border-radius: 6; -fx-prompt-text-fill: #658273;" />
                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #1E8A35; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand;" text="Nuevo" />
                                <Button fx:id="btnEditar" onAction="#handleEditar" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #386646; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand;" text="Editar" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Button onAction="#handleGuardar" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #55AB66; -fx-background-radius: 6; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-cursor: hand;" text="Guardar" />
                                <Button onAction="#handleCancelar" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: transparent; -fx-border-color: #658273; -fx-border-radius: 6; -fx-text-fill: #386646; -fx-cursor: hand;" text="Cancelar" />
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>
                <Label fx:id="lblMensaje" style="-fx-text-fill: #386646; -fx-font-size: 12px;" wrapText="true" />
            </children>
            <BorderPane.margin>
                <Insets right="20.0" />
            </BorderPane.margin>
        </VBox>
    </left>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #071A09;" text="Lista de Detalles de Venta" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #658273;" text="Consulta y gestiona las líneas de venta registradas" />
                    </children>
                </VBox>

                <!-- Buscador -->
                <TextField fx:id="txtBuscar" prefHeight="38.0" promptText="🔍 Buscar por ID, no. venta, ISBN, cantidad o precio…" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #9BBABA; -fx-border-radius: 8; -fx-padding: 0 12 0 12; -fx-prompt-text-fill: #658273;" />

                <!-- Tabla de Datos -->
                <TableView fx:id="tablaDetalleVenta" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #9BBABA; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(7, 26, 9, 0.04), 6, 0, 0, 2);">
                    <columns>
                        <TableColumn fx:id="colIdDetalleVenta" prefWidth="130.0" text="ID Detalle" />
                        <TableColumn fx:id="colNoVenta" prefWidth="130.0" text="No. Venta" />
                        <TableColumn fx:id="colIsbn" prefWidth="180.0" text="ISBN" />
                        <TableColumn fx:id="colCantidad" prefWidth="110.0" text="Cantidad" />
                        <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Paginación / Navegación -->
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <children>
                        <Button fx:id="btnPrimero" onAction="#handlePrimero" style="-fx-background-color: #FFFFFF; -fx-border-color: #8FB5A1; -fx-border-radius: 6; -fx-text-fill: #071A09; -fx-cursor: hand;" text="« Primero" />
                        <Button fx:id="btnAnterior" onAction="#handleAnterior" style="-fx-background-color: #FFFFFF; -fx-border-color: #8FB5A1; -fx-border-radius: 6; -fx-text-fill: #071A09; -fx-cursor: hand;" text="‹ Anterior" />
                        <Button fx:id="btnSiguiente" onAction="#handleSiguiente" style="-fx-background-color: #FFFFFF; -fx-border-color: #8FB5A1; -fx-border-radius: 6; -fx-text-fill: #071A09; -fx-cursor: hand;" text="Siguiente ›" />
                        <Button fx:id="btnUltimo" onAction="#handleUltimo" style="-fx-background-color: #FFFFFF; -fx-border-color: #8FB5A1; -fx-border-radius: 6; -fx-text-fill: #071A09; -fx-cursor: hand;" text="Último »" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>