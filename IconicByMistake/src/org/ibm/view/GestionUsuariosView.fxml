<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1100.0"
            stylesheets="@style/gestionusuariosstyle.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.ibm.controller.GestionUsuariosController">

    <children>

        <!-- BARRA LATERAL -->
        <VBox prefWidth="220.0"
              spacing="15.0"
              style="-fx-background-color: #071A09;"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <padding>
                <Insets bottom="25.0"
                        left="20.0"
                        right="20.0"
                        top="30.0"/>
            </padding>

            <children>

                <Label text="ICONIC BY&#10;MISTAKE"
                       textFill="WHITE">
                    <font>
                        <Font name="Century Gothic Bold"
                              size="22.0"/>
                    </font>
                </Label>

                <Label text="Administración"
                       textFill="#9BBABA">
                    <font>
                        <Font name="Century Gothic"
                              size="13.0"/>
                    </font>
                </Label>

                <Label text="Gestión de Usuarios"
                       styleClass="menu-activo"/>

                <!-- Empuja el botón hacia la parte inferior -->
                <VBox VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnVolver"
                        text="←  Volver al panel"
                        onAction="#volverAlDashboard"
                        maxWidth="1.7976931348623157E308"
                        styleClass="btn-volver"/>

            </children>

        </VBox>

        <!-- CONTENIDO PRINCIPAL -->
        <VBox spacing="18.0"
              AnchorPane.bottomAnchor="25.0"
              AnchorPane.leftAnchor="250.0"
              AnchorPane.rightAnchor="25.0"
              AnchorPane.topAnchor="25.0">

            <children>

                <Label text="Gestión de Usuarios"
                       textFill="#071A09">
                    <font>
                        <Font name="Century Gothic Bold"
                              size="28.0"/>
                    </font>
                </Label>

                <Label text="Administra los usuarios, roles y estados del sistema."
                       textFill="#658273">
                    <font>
                        <Font name="Century Gothic"
                              size="13.0"/>
                    </font>
                </Label>

                <!-- FORMULARIO -->
                <VBox spacing="14.0"
                      styleClass="card">

                    <padding>
                        <Insets bottom="20.0"
                                left="20.0"
                                right="20.0"
                                top="20.0"/>
                    </padding>

                    <children>

                        <Label text="Datos del usuario"
                               textFill="#071A09">
                            <font>
                                <Font name="Century Gothic Bold"
                                      size="17.0"/>
                            </font>
                        </Label>

                        <!-- PRIMERA FILA -->
                        <HBox spacing="15.0">

                            <children>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Usuario"/>

                                        <TextField fx:id="txtUsuario"
                                                   promptText="Nombre de usuario"/>

                                    </children>

                                </VBox>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Nombre"/>

                                        <TextField fx:id="txtNombre"
                                                   promptText="Nombre"/>

                                    </children>

                                </VBox>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Apellido"/>

                                        <TextField fx:id="txtApellido"
                                                   promptText="Apellido"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- SEGUNDA FILA -->
                        <HBox spacing="15.0">

                            <children>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Correo"/>

                                        <TextField fx:id="txtCorreo"
                                                   promptText="correo@ejemplo.com"/>

                                    </children>

                                </VBox>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Contraseña"/>

                                        <PasswordField fx:id="txtContrasena"
                                                       promptText="Contraseña"/>

                                    </children>

                                </VBox>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Rol"/>

                                        <ComboBox fx:id="cbRol"
                                                  maxWidth="1.7976931348623157E308"
                                                  promptText="Seleccione"/>

                                    </children>

                                </VBox>

                                <VBox spacing="5.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Estado"/>

                                        <ComboBox fx:id="cbEstado"
                                                  maxWidth="1.7976931348623157E308"
                                                  promptText="Seleccione"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <!-- BOTONES CRUD -->
                        <HBox spacing="10.0">

                            <children>

                                <Button fx:id="btnGuardar"
                                        onAction="#guardarUsuario"
                                        styleClass="btn-primary"
                                        text="Guardar"/>

                                <Button fx:id="btnActualizar"
                                        onAction="#actualizarUsuario"
                                        styleClass="btn-secondary"
                                        text="Actualizar"/>

                                <Button fx:id="btnEliminar"
                                        onAction="#eliminarUsuario"
                                        styleClass="btn-danger"
                                        text="Eliminar"/>

                                <Button fx:id="btnLimpiar"
                                        onAction="#limpiarCampos"
                                        styleClass="btn-neutral"
                                        text="Limpiar"/>

                            </children>

                        </HBox>

                    </children>

                </VBox>

                <!-- TABLA DE USUARIOS -->
                <VBox spacing="12.0"
                      styleClass="card"
                      VBox.vgrow="ALWAYS">

                    <padding>
                        <Insets bottom="20.0"
                                left="20.0"
                                right="20.0"
                                top="20.0"/>
                    </padding>

                    <children>

                        <Label text="Usuarios registrados"
                               textFill="#071A09">

                            <font>
                                <Font name="Century Gothic Bold"
                                      size="17.0"/>
                            </font>

                        </Label>

                        <TableView fx:id="tblUsuarios"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="colId"
                                             prefWidth="55.0"
                                             text="ID"/>

                                <TableColumn fx:id="colUsuario"
                                             prefWidth="120.0"
                                             text="Usuario"/>

                                <TableColumn fx:id="colNombre"
                                             prefWidth="120.0"
                                             text="Nombre"/>

                                <TableColumn fx:id="colApellido"
                                             prefWidth="120.0"
                                             text="Apellido"/>

                                <TableColumn fx:id="colCorreo"
                                             prefWidth="190.0"
                                             text="Correo"/>

                                <TableColumn fx:id="colRol"
                                             prefWidth="100.0"
                                             text="Rol"/>

                                <TableColumn fx:id="colEstado"
                                             prefWidth="90.0"
                                             text="Activo"/>

                            </columns>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </children>

</AnchorPane>